# Environment Variables Template
# Copy this file to .env and configure as needed for local execution

# Python path configuration (optional, defaults to repository root)
PYTHONPATH=.

# Results and artifacts output directory
RESULTS_DIR=results

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Default seed for deterministic synthetic dataset generation
DEFAULT_RANDOM_SEED=42

# Hardware device preference: cpu, cuda (defaults to auto-detect)
DEVICE=cpu
